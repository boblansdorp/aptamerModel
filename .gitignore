############################################
# Wolfram / Mathematica
############################################

# Notebooks and packages (keep tracked by default)
# *.nb
# *.wl
# *.wls
# *.m

# Autosave / backups / temp
*.nb~
*.wl~
*.wls~
*.m~
*.bak
*.backup
*.autosave
*.tmp
*.swp
*.swo

# Wolfram Cloud / CDF artifacts (often generated)
*.cdf
*.cdf~
*.nbp

# Notebook cache / front end leftovers (common in project dirs)
*.mx
*.m~*
*.ma
*.tr
*.wlt
*.wxf
*.wdx

# Some people generate compiled artifacts or library outputs
*.dll
*.so
*.dylib
*.a
*.lib
*.o
*.obj


# txt files (exemptions below)
*.txt

# Build / output folders
build/
dist/
out/
output/
tmp/

# sandbox folder
sandbox/

# data folders — ignore contents by default so exemptions can override
experimentalData/*
fracpole/
oldResults/
results/*

