  RowBox[{
   RowBox[{
    RowBox[{"fPlot", "=", 
     RowBox[{"{", 
      RowBox[{"25", ",", "200"}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "concentration", " ", "range"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"concRange", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"10", "^", "x"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"Log10", "[", 
          RowBox[{"1", "*", 
           RowBox[{"10", "^", 
            RowBox[{"-", "6"}]}]}], "]"}], ",", 
         RowBox[{"Log10", "[", 
          RowBox[{"1", "*", 
           RowBox[{"10", "^", 
            RowBox[{"-", "1"}]}]}], "]"}], ",", "0.1"}], "}"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "fitted", " ", "parameters"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rct0Fit", "=", 
     RowBox[{"result", "[", "\"\<Rct0\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rct1Fit", "=", 
     RowBox[{"result", "[", "\"\<Rct1\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
