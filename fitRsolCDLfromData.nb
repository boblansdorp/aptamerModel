}]}]}]}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Separate", " ", "experimental", " ", "points", " ", "by", " ", 
     "frequency"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expDataByFreq", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"filteredData", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "==", "f"}], "&"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"f", ",", "fPlot"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "label", " ", "positions"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"labelPrimitives", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"data", ",", "meanX", ",", "maxY", ",", "labelPos"}], "}"}],
          ",", 
         RowBox[{
          RowBox[{"data", "=", 
           RowBox[{"expDataByFreq", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "data", "]"}], ">", "0"}], ",", 
            RowBox[{
             RowBox[{"meanX", "=", 
              RowBox[{"Mean", "[", 
               RowBox[{"data", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"maxY", "=", 
              RowBox[{"Max", "[", 
               RowBox[{"data", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"labelPos", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"meanX", "-", "6"}], ",", 
                RowBox[{"maxY", "*", "1.2"}]}], "}"}]}], ";", 
             RowBox[{"(*", 
              RowBox[{
              "place", " ", "label", " ", "10", "%", " ", "above", " ", 
               "max"}], "*)"}], 
             RowBox[{"Text", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"ToString", "[", 
                   RowBox[{"fPlot", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "<>", 
                  "\"\< Hz\>\""}], ",", "Black", ",", "Bold", ",", "14"}], 
                "]"}], ",", "labelPos"}], "]"}]}], ",", "Nothing"}], 
           "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "fPlot", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
