    "Define", " ", "range", " ", "of", " ", "kD", " ", "values", " ", 
     "around", " ", "the", " ", "fit"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kDValues", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"kDFit", "/", "4"}], ",", 
       RowBox[{"kDFit", "/", "2"}], ",", "kDFit", ",", 
       RowBox[{"2", "*", "kDFit"}], ",", 
       RowBox[{"4", "*", "kDFit"}]}], "}"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "legend", " ", "labels", " ", "in", " ", "mM"}], 
