Cell[BoxData[{
 RowBox[{
  RowBox[{"gammaLabels", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\"\<Gamma = \>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "1"}], "}"}]}], "]"}], "]"}]}], ")"}], "&"}], "/@",
     "gammaValues"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kDfitVal", "=", " ", 
   RowBox[{"kDfit", "/.", " ", "fitResult"}]}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"the", " ", "effective", " ", "kD"}], " ", "*)"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"allResultsGamma", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"(*", 
      RowBox[{
      "Update", " ", "Rct", " ", "and", " ", "Capt", " ", "for", " ", "this", 
       " ", "Gamma"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"rct0Eff", "=", 
        RowBox[{"rct0Baseline", "/", "gamma"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rct1Eff", "=", 
        RowBox[{"rct1Baseline", "/", "gamma"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"captEff", "=", 
        RowBox[{"captBaseline", "*", "gamma"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"paramsGamma", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"constants", ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Rct0\>\"", "->", "rct0Eff"}], ",", 
            RowBox[{"\"\<Rct1\>\"", "->", "rct1Eff"}], ",", 
            RowBox[{"\"\<kD\>\"", "->", "kDFit"}], ",", 
            RowBox[{"\"\<Capt\>\"", "->", "captEff"}]}], "|>"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Compute", " ", "KDMs", " ", "for", " ", "all", " ", 
         "concentrations"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"kdmGammaVals", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"conc", ",", 
            RowBox[{"ComputeKDM", "[", 
             RowBox[{
             "conc", ",", "fLow", ",", "fHigh", ",", "paramsGamma", ",", 
              "ilow0RefinVivo", ",", "ihigh0RefinVivo"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"conc", ",", "concentrationRange"}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"For", " ", "each", " ", "KDM"}], ",", 
         RowBox[{"estimate", " ", "concentration"}]}], "*)"}], 
       RowBox[{"estimates", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"trueConc", "=", 
               RowBox[{"kdmGammaVals", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ",", 
              RowBox[{"KDMmeasured", "=", 
               RowBox[{"kdmGammaVals", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ",", 
              "estimatedConc", ",", "percentError"}], "}"}], ",", 
            RowBox[{
             RowBox[{"estimatedConc", "=", 
              RowBox[{"EstimateConcentration", "[", 
               RowBox[{"KDMmeasured", ",", "kDEffective", ",", "kdmMaxVal"}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"percentError", "=", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"trueConc", "==", "0"}], ",", "Indeterminate", ",", 
                RowBox[{"100", "*", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"estimatedConc", "-", "trueConc"}], ")"}], "/", 
                  "trueConc"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{
              "trueConc", ",", "KDMmeasured", ",", "estimatedConc", ",", 
               "percentError"}], "}"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "kdmGammaVals", "]"}]}], "}"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", "estimates"}], ",", 
      RowBox[{"{", 
       RowBox[{"gamma", ",", "gammaValues"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
