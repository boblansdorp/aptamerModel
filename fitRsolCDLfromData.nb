    RowBox[{
    "Legend", " ", "items", " ", "for", " ", "the", " ", "guideline", " ", 
     "lines"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"guidelineStyles", "=", 
     RowBox[{"{", 
      RowBox[{"Directive", "[", 
       RowBox[{"LightGray", ",", "Dashed", ",", "Medium"}], "]"}], "}"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"guidelineLabels", "=", 
     RowBox[{"{", "\"\<+/- 20% error\>\"", "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Create", " ", "legends", " ", "separately"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"legendGuidelines", "=", 
     RowBox[{"LineLegend", "[", 
      RowBox[{"guidelineStyles", ",", "guidelineLabels", ",", 
       RowBox[{"LegendLabel", "->", "\"\<Guidelines\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"legendRsol", "=", 
     RowBox[{"LineLegend", "[", 
      RowBox[{"rsolLabels", ",", 
       RowBox[{"LegendLabel", "->", "\"\<Rsol Cases\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Combine", " ", "them"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"combinedLegend", "=", 
     RowBox[{"SwatchLegend", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"guidelineStyles", ",", 
         RowBox[{
          RowBox[{"ColorData", "[", "97", "]"}], "/@", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "rsolLabels", "]"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"Join", "[", 
        RowBox[{"guidelineLabels", ",", "rsolLabels"}], "]"}], ",", 
       RowBox[{"LegendLabel", "->", "\"\<Legend\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Alternatively", ",", 
     RowBox[{"if", " ", "you", " ", "want", " ", "separate", " ", 
      RowBox[{"boxes", ":"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"combinedLegend", "=", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{"legendGuidelines", ",", "legendRsol"}], "}"}], "]"}]}], 
     ";"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Scatter", " ", "plots", " ", "in", " ", "\[Micro]M"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"scatterPlots", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"plotDataSetsMicroMolar", ",", 
       RowBox[{"Joined", "->", "True"}], ",", 
       RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<True Concentration (\[Micro]M)\>\"", ",", 
          "\"\<Estimated Concentration (\[Micro]M)\>\""}], "}"}]}], ",", 
       RowBox[{"FrameTicksStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"FontSize", "->", "12"}], "]"}]}], ",", 
       RowBox[{"PlotRange", "->", "ClarkeErrorPlotRangeMicroMolar"}], ",", 
       RowBox[{"AspectRatio", "->", "1"}], ",", 
       RowBox[{"PlotLegends", "->", "combinedLegend"}], ",", 
       RowBox[{
       "PlotLabel", "->", 
        "\"\<Estimated vs True Concentration for Different Rsol (\[Micro]M)\>\
\""}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Combine", " ", "plots"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"finalPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{"oneToOnePlot", ",", "errorLines", ",", "scatterPlots", ",", 
       RowBox[{"PlotRange", "->", "ClarkeErrorPlotRangeMicroMolar"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", "finalPlot", 
