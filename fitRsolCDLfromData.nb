Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Find", " ", "lowest", " ", "concentration"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"uniqueConcs", "=", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"filteredData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"minConc", "=", 
     RowBox[{"Min", "[", "uniqueConcs", "]"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Extract", " ", "data", " ", "at", " ", "lowest", " ", "concentration"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"lowestConcData", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"filteredData", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "==", "minConc"}], "&"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "fitted", " ", "parameters"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rct0Fit", "=", 
     RowBox[{"result", "[", "\"\<Rct0\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rct1Fit", "=", 
     RowBox[{"result", "[", "\"\<Rct1\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kDFit", "=", 
     RowBox[{"result", "[", "\"\<kD\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"captFit", "=", 
     RowBox[{"result", "[", "\"\<Capt\>\"", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "range", " ", "of", " ", "Rct0", " ", "values", " ", 
     "around", " ", "fit"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rct0Values", "=", 
     RowBox[{"{", 
      RowBox[{
      "4000", ",", "6000", ",", "rct0Fit", ",", "10000", ",", "12000"}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "legend", " ", "labels"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"legendLabels", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "0"}], "}"}]}], "]"}], "]"}], "&"}], "/@", 
      "rct0Values"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "rainbow", " ", "colors"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"colors", "=", 
     RowBox[{
      RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "/@", 
      RowBox[{"Rescale", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "rct0Values", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"Length", "[", "rct0Values", "]"}]}], "}"}]}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Frequencies", " ", "to", " ", "evaluate", " ", "theory", " ", "curves"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"frequencies", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{"lowestConcData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "theory", " ", "curves", " ", "as", " ", "lists", " ", 
     "of", " ", "points"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theoryCurves", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"f", ",", 
           RowBox[{"ModelFunction", "[", 
            RowBox[{"f", ",", "minConc", ",", 
             RowBox[{"Join", "[", 
              RowBox[{"constants", ",", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<Rct0\>\"", "->", 
                  RowBox[{"rct0Values", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                 RowBox[{"\"\<Rct1\>\"", "->", "rct1Fit"}], ",", 
                 RowBox[{"\"\<kD\>\"", "->", "kDFit"}], ",", 
                 RowBox[{"\"\<Capt\>\"", "->", "captFit"}]}], "|>"}]}], 
              "]"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"f", ",", "frequencies"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "rct0Values", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Make", " ", "the", " ", "theory", " ", "plot"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theoryPlot", "=", 
     RowBox[{"ListLogLinearPlot", "[", 
      RowBox[{"theoryCurves", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Directive", "[", 
            RowBox[{"#", ",", "Thick"}], "]"}], "&"}], "/@", "colors"}], 
         ")"}]}], ",", 
       RowBox[{"Joined", "->", "True"}], ",", 
       RowBox[{"PlotMarkers", "->", "None"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Frequency (Hz)\>\"", ",", "\"\<\[CapitalDelta]I (A)\>\""}], 
         "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"SwatchLegend", "[", 
           RowBox[{"colors", ",", "legendLabels", ",", 
            RowBox[{"LegendLabel", "->", "\"\<Rct0 Values\>\""}]}], "]"}], 
          ",", "Right"}], "]"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "the", " ", "experimental", " ", "data"}], "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"expPlot", "=", 
     RowBox[{"ListLogLinearPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lowestConcData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", "Black", "}"}]}], ",", 
       RowBox[{"PlotMarkers", "->", 
        RowBox[{"{", "Automatic", "}"}]}], ",", 
       RowBox[{"Joined", "->", "False"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Combine", " ", "plots"}], "*)"}], "\n", 
   RowBox[{"Show", "[", 
    RowBox[{"theoryPlot", ",", "expPlot", ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\n"}]}]], "Input",
