     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1000"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1000"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"1", ":", 
     RowBox[{"1", " ", "line", " ", "in", " ", "\[Micro]M"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"oneToOnePlot", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{"x", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1000"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Black", ",", "Dashed", ",", "Thick"}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", "None"}], ",", 
       RowBox[{"PlotRange", "->", "ClarkeErrorPlotRangeMicroMolar"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Error", " ", "lines", " ", 
