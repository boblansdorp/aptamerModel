Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Find", " ", "highest", " ", "concentration"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"uniqueConcs", "=", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"filteredData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxConc", "=", 
     RowBox[{"Max", "[", "uniqueConcs", "]"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Extract", " ", "data", " ", "at", " ", "highest", " ", "concentration"}],
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"highestConcData", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"filteredData", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "==", "maxConc"}], "&"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Evaluate", " ", "model", " ", "at", " ", "fitted", " ", "parameters"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rct0Fit", "=", 
     RowBox[{"result", "[", "\"\<Rct0\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rct1Fit", "=", 
     RowBox[{"result", "[", "\"\<Rct1\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kDFit", "=", 
     RowBox[{"result", "[", "\"\<kD\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"captFit", "=", 
    RowBox[{"result", "[", "\"\<Capt\>\"", "]"}]}], "\n", 
   RowBox[{
    RowBox[{"modelCurve", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"f", ",", 
         RowBox[{"ModelFunction", "[", 
          RowBox[{"f", ",", "maxConc", ",", 
           RowBox[{"Join", "[", 
            RowBox[{"constants", ",", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Rct0\>\"", "->", "rct0Fit"}], ",", 
               RowBox[{"\"\<Rct1\>\"", "->", "rct1Fit"}], ",", 
               RowBox[{"\"\<kD\>\"", "->", "kDFit"}], ",", " ", 
               RowBox[{"\"\<Capt\>\"", "->", "captFit"}]}], "|>"}]}], "]"}]}],
           "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"f", ",", 
         RowBox[{"Sort", "[", 
          RowBox[{"highestConcData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Plot", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ListLogLinearPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"highestConcData", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], ",", 
       "modelCurve"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Red", ",", "Blue"}], "}"}]}], ",", 
     RowBox[{"PlotMarkers", "->", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", "None"}], "}"}]}], ",", 
     RowBox[{"Joined", "->", 
      RowBox[{"{", 
       RowBox[{"False", ",", "True"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
