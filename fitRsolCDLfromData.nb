      RowBox[{"{", 
       RowBox[{"0", ",", "0.001"}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"oneToOnePlot", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{"x", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "minConc", ",", "maxConc"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Black", ",", "Dashed"}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", "None"}], ",", " ", 
       RowBox[{"PlotRange", "->", "ClarkeErrorPlotRange"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Create", " ", "the", " ", "scatter", " ", "plots", " ", "for", " ", 
     "all", " ", "Rsol", " ", "datasets"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"scatterPlots", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"plotDataSets", ",", 
       RowBox[{"Joined", "->", "True"}], ",", 
       RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
