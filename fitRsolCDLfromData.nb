  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"plotDataSets", "=", 
     RowBox[{"allResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "All", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
