     RowBox[{
     "1", " ", "line", " ", "as", " ", "a", " ", "function", " ", "plot"}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"oneToOnePlot", "=", 
     RowBox[{"LogLogPlot", "[", 
      RowBox[{"x", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "minConc", ",", "maxConc"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Black", ",", "Dashed"}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", "None"}], ",", " ", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<True Concentration (M)\>\"", ",", 
          "\"\<Estimated Concentration (M)\>\""}], "}"}]}], ",", " ", 
       RowBox[{"AspectRatio", "->", "1"}], ",", " ", 
       RowBox[{"GridLines", "->", "True"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Create", " ", "the", " ", "scatter", " ", "plots", " ", "for", " ", 
     "all", " ", "Rsol", " ", "datasets"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"scatterPlots", "=", 
     RowBox[{"ListLogLogPlot", "[", 
      RowBox[{"plotDataSets", ",", 
       RowBox[{"Joined", "->", "True"}], ",", 
       RowBox[{"PlotMarkers", "->", "None"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<True Concentration (M)\>\"", ",", 
          "\"\<Estimated Concentration (M)\>\""}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"minConc", ",", "maxConc"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"minConc", ",", "maxConc"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"AspectRatio", "->", "1"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"LineLegend", "[", 
           RowBox[{"rsolLabels", ",", 
            RowBox[{"LegendLabel", "->", "\"\<Rsol Cases\>\""}]}], "]"}], ",",
           "Right"}], "]"}]}], ",", 
       RowBox[{
       "PlotLabel", "->", 
        "\"\<Estimated vs True Concentration for Different Rsol\>\""}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Combine", " ", "plots"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"finalPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{"oneToOnePlot", ",", " ", "scatterPlots"}], " ", "]"}]}], ";"}],
    "\n", "\[IndentingNewLine]", "finalPlot", "\n"}]}]], "Input",
