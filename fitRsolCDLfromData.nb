    "Will", " ", "store", " ", "curves", " ", "for", " ", "each", " ", "freq",
      " ", "and", " ", "kD", " ", "value"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theoryCurvesAll", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"conc", ",", 
               RowBox[{"ModelFunction", "[", 
                RowBox[{"f", ",", "conc", ",", 
                 RowBox[{"Join", "[", 
                  RowBox[{"constants", ",", 
                   RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<Rct0\>\"", "->", "rct0Fit"}], ",", 
                    RowBox[{"\"\<Rct1\>\"", "->", "rct1Fit"}], ",", 
                    RowBox[{"\"\<kD\>\"", "->", "kDval"}], ",", 
                    RowBox[{"\"\<Capt\>\"", "->", "captFit"}]}], "|>"}]}], 
                  "]"}]}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"conc", ",", "concRange"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"kDval", ",", "kDValues"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"f", ",", "fPlot"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"We", "\[CloseCurlyQuote]"}], "ll", " ", "build", " ", "plot", 
     " ", "styles", " ", "to", " ", "distinguish", " ", "frequencies", " ", 
     "and", " ", "kD"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"There", " ", "are", " ", "Length", 
     RowBox[{"(", "kDValues", ")"}], " ", "curves", " ", "per", " ", 
     "frequency"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"freqStyles", "=", 
     RowBox[{"{", 
      RowBox[{"Solid", ",", "Solid"}], "}"}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"e", ".", "g", ".", "one"}], " ", "style", " ", "per", " ", 
     "frequency"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"plotStyles", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"colors", "[", 
            RowBox[{"[", "k", "]"}], "]"}], ",", 
           RowBox[{"freqStyles", "[", 
            RowBox[{"[", "fIndex", "]"}], "]"}], ",", "Thick"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"fIndex", ",", 
           RowBox[{"Length", "[", "fPlot", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "kDValues", "]"}]}], "}"}]}], "]"}], ",", 
       "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"--", 
