          RowBox[{"-", "20"}]}]}], "%"}], ",", 
       RowBox[{
        RowBox[{"+", 
         RowBox[{"/", 
          RowBox[{"-", "40"}]}]}], "%"}]}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"errorLines", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1.2", "*", "x"}], ",", 
         RowBox[{"0.8", "*", "x"}], ",", 
         RowBox[{"1.4", "*", "x"}], ",", 
         RowBox[{"0.6", "*", "x"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1000"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{"LightGray", ",", "Dashed", ",", "Medium"}], "]"}], ",", 
          RowBox[{"Directive", "[", 
           RowBox[{"LightGray", ",", "Dashed", ",", "Medium"}], "]"}], ",", 
          RowBox[{"Directive", "[", 
           RowBox[{"LightGray", ",", "Dotted", ",", "Medium"}], "]"}], ",", 
          RowBox[{"Directive", "[", 
           RowBox[{"LightGray", ",", "Dotted", ",", "Medium"}], "]"}]}], 
         "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "ClarkeErrorPlotRangeMicroMolar"}], ",", 
       RowBox[{"PlotLegends", "->", "None"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Scatter", " ", "plots", " ", "in", " ", "\[Micro]M"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"scatterPlots", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"plotDataSetsMicroMolar", ",", 
       RowBox[{"Joined", "->", "True"}], ",", 
       RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<True Concentration (\[Micro]M)\>\"", ",", 
          "\"\<Estimated Concentration (\[Micro]M)\>\""}], "}"}]}], ",", 
       RowBox[{"FrameTicksStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"FontSize", "->", "12"}], "]"}]}], ",", 
       RowBox[{"PlotRange", "->", "ClarkeErrorPlotRangeMicroMolar"}], ",", 
       RowBox[{"AspectRatio", "->", "1"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"LineLegend", "[", 
           RowBox[{"rsolLabels", ",", 
            RowBox[{"LegendLabel", "->", "\"\<Rsol Cases\>\""}]}], "]"}], ",",
           "Right"}], "]"}]}], ",", 
       RowBox[{
       "PlotLabel", "->", 
        "\"\<Estimated vs True Concentration for Different Rsol (\[Micro]M)\>\
\""}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Combine", " ", "plots"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"finalPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{"oneToOnePlot", ",", "errorLines", ",", "scatterPlots"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", "finalPlot", "\n", 
