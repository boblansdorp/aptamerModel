     "for", " ", "axis", " ", "limits"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allConcVals", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"plotDataSets", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"maxConc", "=", 
     RowBox[{"Max", "[", "allConcVals", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"minConc", "=", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{"Select", "[", 
          RowBox[{"allConcVals", ",", 
           RowBox[{
            RowBox[{"#", ">", "0"}], "&"}]}], "]"}], "]"}], "/", "10"}], ",", 
       RowBox[{"10", "^", 
        RowBox[{"-", "9"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
