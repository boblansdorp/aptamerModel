        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"theoryPlot", "=", 
    RowBox[{"ListLogLinearPlot", "[", 
     RowBox[{"theoryCurvesMicroA", ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{"#", ",", "Thick"}], "]"}], "&"}], "/@", "colors"}], 
        ")"}]}], ",", 
      RowBox[{"Joined", "->", "True"}], ",", 
      RowBox[{"PlotMarkers", "->", "None"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"Axes", "->", "False"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Frequency (Hz)\>\"", ",", "16", ",", "Bold"}], "]"}], 
         ",", 
         RowBox[{"Style", "[", 
          RowBox[{
          "\"\<\[CapitalDelta]I (\[Micro]A)\>\"", ",", "16", ",", "Bold"}], 
          "]"}]}], "}"}]}], ",", 
      RowBox[{"FrameTicks", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
