Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Find", " ", "highest", " ", "concentration"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"uniqueConcs", "=", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"filteredData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxConc", "=", 
     RowBox[{"Max", "[", "uniqueConcs", "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Extract", " ", "data", " ", "at", " ", "highest", " ", "concentration"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{"lowestConcData", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"filteredData", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "==", "0."}], "&"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"highestConcData", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"filteredData", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "==", "maxConc"}], "&"}]}], "]"}]}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Evaluate", " ", "model", " ", "at", " ", "fitted", " ", "parameters"}], 
