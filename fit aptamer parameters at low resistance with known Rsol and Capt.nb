Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeOutsideTicksCustom", "[", "vals_", "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"ToString", "[", "x", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0.02"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "vals"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeOutsideLogTicks", "[", 
     RowBox[{"min_", ",", "max_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "major", "}"}], ",", 
      RowBox[{
       RowBox[{"major", "=", 
        RowBox[{"10", "^", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"Ceiling", "[", 
            RowBox[{"Log10", "[", "min", "]"}], "]"}], ",", 
           RowBox[{"Floor", "[", 
            RowBox[{"Log10", "[", "max", "]"}], "]"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#", ",", 
            RowBox[{"Superscript", "[", 
             RowBox[{"10", ",", 
              RowBox[{"Log10", "[", "#", "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0.02"}], "}"}]}], "}"}], "&"}], ")"}], "/@", 
        "major"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Same", " ", "data"}], ",", 
    RowBox[{"converted", " ", "to", " ", "microamps"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"theoryCurvesMicroA", "=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"10", "^", "6"}], " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], "&"}], ",", 
      "theoryCurves", ",", 
      RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"expDataMicroA", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"10", "^", "6"}], " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], "&"}], ")"}], "/@", 
     RowBox[{"lowestConcData", "[", 
      RowBox[{"[", 
