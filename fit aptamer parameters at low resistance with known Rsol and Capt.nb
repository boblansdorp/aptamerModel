Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Find", " ", "lowest", " ", "concentration"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"uniqueConcs", "=", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"filteredData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"minConc", "=", 
     RowBox[{"Min", "[", "uniqueConcs", "]"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Extract", " ", "data", " ", "at", " ", "lowest", " ", "concentration"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"lowestConcData", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"filteredData", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "==", "minConc"}], "&"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "fitted", " ", "parameters"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rct0Fit", "=", 
     RowBox[{"result", "[", "\"\<Rct0\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rct1Fit", "=", 
     RowBox[{"result", "[", "\"\<Rct1\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kDFit", "=", 
     RowBox[{"result", "[", "\"\<kD\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"captFit", "=", 
     RowBox[{"result", "[", "\"\<Capt\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "range", " ", "of", " ", "Rct0", " ", "values", " ", 
     "around", " ", "fit"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rct0Values", "=", 
     RowBox[{"{", 
      RowBox[{
      "5000", ",", "10000", ",", "rct0Fit", ",", "25000", ",", "35000"}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "legend", " ", "labels"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"legendLabels", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "0"}], "}"}]}], "]"}], "]"}], "&"}], "/@", 
      "rct0Values"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "rainbow", " ", "colors"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"colors", "=", 
     RowBox[{
      RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "/@", 
      RowBox[{"Rescale", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "rct0Values", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"Length", "[", "rct0Values", "]"}]}], "}"}]}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Frequencies", " ", "to", " ", "evaluate", " ", "theory", " ", "curves"}],
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"frequencies", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{"lowestConcData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "theory", " ", "curves", " ", "as", " ", "lists", " ", 
     "of", " ", "points"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"theoryCurves", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"f", ",", 
           RowBox[{"ModelFunction", "[", 
            RowBox[{"f", ",", "minConc", ",", 
             RowBox[{"Join", "[", 
              RowBox[{"constants", ",", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<Rct0\>\"", "->", 
                  RowBox[{"rct0Values", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                 RowBox[{"\"\<Rct1\>\"", "->", "rct1Fit"}], ",", 
                 RowBox[{"\"\<kD\>\"", "->", "kDFit"}], ",", 
                 RowBox[{"\"\<Capt\>\"", "->", "captFit"}]}], "|>"}]}], 
              "]"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"f", ",", "frequencies"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "rct0Values", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Make", " ", "the", " ", "theory", " ", "plot"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"theoryPlot", "=", 
     RowBox[{"ListLogLinearPlot", "[", 
      RowBox[{"theoryCurves", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Directive", "[", 
            RowBox[{"#", ",", "Thick"}], "]"}], "&"}], "/@", "colors"}], 
         ")"}]}], ",", 
       RowBox[{"Joined", "->", "True"}], ",", 
       RowBox[{"PlotMarkers", "->", "None"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Frequency (Hz)\>\"", ",", "\"\<\[CapitalDelta]I (A)\>\""}], 
         "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"SwatchLegend", "[", 
           RowBox[{"colors", ",", "legendLabels", ",", 
            RowBox[{"LegendLabel", "->", "\"\<Rct0 Values\>\""}]}], "]"}], 
          ",", "Right"}], "]"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "the", " ", "experimental", " ", "data"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expPlot", "=", 
     RowBox[{"ListLogLinearPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lowestConcData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", "Black", "}"}]}], ",", 
       RowBox[{"PlotMarkers", "->", 
        RowBox[{"{", "Automatic", "}"}]}], ",", 
       RowBox[{"Joined", "->", "False"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Combine", " ", "plots"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"theoryPlot", ",", "expPlot", ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\n"}]}]], "Input",
