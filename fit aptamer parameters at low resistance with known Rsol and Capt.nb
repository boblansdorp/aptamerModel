       ",", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dataTriplesLog", "=", 
     RowBox[{"dataTriples", "/.", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"f_", ",", "c_", ",", "z_"}], "}"}], ":>", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Log10", "[", "f", "]"}], ",", "c", ",", "z"}], "}"}]}]}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "Make", " ", "the", " ", "contour", " ", "plot"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"LovricContourPlotTheory", "=", 
