            RowBox[{"{", 
             RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}], 
            "]"}], ",", "None"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"makeOutsideLogTicks", "[", 
            RowBox[{
             RowBox[{"Min", "[", "frequencies", "]"}], ",", 
             RowBox[{"Max", "[", "frequencies", "]"}]}], "]"}], ",", "None"}],
           "}"}]}], "}"}]}], ",", 
      RowBox[{"FrameTicksStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"FontFamily", "->", "\"\<Helvetica\>\""}], ",", 
         RowBox[{"FontSize", "->", "14"}], ",", "Black"}], "]"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
