Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ModelFunction", "[", 
      RowBox[{
      "frequency_", ",", "concentration_", ",", "params_Association"}], "]"}],
      ":=", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"theta", ",", "RctEff", ",", "t1Local", ",", "expr"}], "}"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"theta", "=", 
         RowBox[{"concentration", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"params", "[", "\"\<kD\>\"", "]"}], "+", 
            "concentration"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"RctEff", "=", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "theta"}], ")"}], "/", 
             RowBox[{"params", "[", "\"\<Rct0\>\"", "]"}]}], "+", 
            RowBox[{"theta", "/", 
             RowBox[{"params", "[", "\"\<Rct1\>\"", "]"}]}]}], ")"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"t1Local", "=", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"2", "*", "frequency"}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"expr", "=", 
         RowBox[{"analyticalCHICurrentExpression", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"CDL", "->", 
             RowBox[{"params", "[", "\"\<CDL\>\"", "]"}]}], ",", 
            RowBox[{"Rsol", "->", 
             RowBox[{"params", "[", "\"\<Rsol\>\"", "]"}]}], ",", 
            RowBox[{"Capt", "->", 
             RowBox[{"params", "[", "\"\<Capt\>\"", "]"}]}], ",", 
            RowBox[{"Rct", "->", "RctEff"}], ",", 
            RowBox[{"t1", "->", "t1Local"}], ",", " ", 
            RowBox[{"fSWV", "->", "frequency"}]}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", "expr"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"STEP", " ", "3"}], ":", 
     RowBox[{"Define", " ", "FitFunction"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"FitFunction", "[", 
      RowBox[{
      "allData_List", ",", "constants_Association", ",", 
       "initialGuesses_Association", ",", "fitVariables_List"}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"modelFunc", ",", "fit", ",", "result"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"modelFunc", "[", 
          RowBox[{
          "f_", ",", "c_", ",", "rct0_", ",", "rct1_", ",", "kD_", ",", 
           "capt_"}], "]"}], ":=", 
         RowBox[{"ModelFunction", "[", 
          RowBox[{"f", ",", "c", ",", 
           RowBox[{"Join", "[", 
            RowBox[{"constants", ",", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Rct0\>\"", "->", "rct0"}], ",", 
               RowBox[{"\"\<Rct1\>\"", "->", "rct1"}], ",", 
               RowBox[{"\"\<kD\>\"", "->", "kD"}], ",", 
               RowBox[{"\"\<Capt\>\"", "->", "capt"}]}], "|>"}]}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fit", "=", 
         RowBox[{"FindFit", "[", "\[IndentingNewLine]", 
          RowBox[{"allData", ",", "\[IndentingNewLine]", 
           RowBox[{"modelFunc", "[", 
            RowBox[{
            "f", ",", "c", ",", "rct0", ",", "rct1", ",", "kD", ",", "capt"}],
             "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"rct0", ",", 
               RowBox[{"initialGuesses", "[", "\"\<Rct0\>\"", "]"}], ",", 
               "100", ",", "50000"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"rct1", ",", 
               RowBox[{"initialGuesses", "[", "\"\<Rct1\>\"", "]"}], ",", 
               "100", ",", "50000"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"kD", ",", 
