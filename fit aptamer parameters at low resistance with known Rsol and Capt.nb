Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Find", " ", "lowest", " ", "concentration"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"uniqueConcs", "=", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"filteredData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxConc", "=", 
     RowBox[{"Max", "[", "uniqueConcs", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Extract", " ", "data", " ", "at", " ", "lowest", " ", "concentration"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"highestConcData", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"filteredData", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "==", "maxConc"}], "&"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "fitted", " ", "parameters"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rct0Fit", "=", 
     RowBox[{"result", "[", "\"\<Rct0\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rct1Fit", "=", 
     RowBox[{"result", "[", "\"\<Rct1\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kDFit", "=", 
     RowBox[{"result", "[", "\"\<kD\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"captFit", "=", 
     RowBox[{"result", "[", "\"\<Capt\>\"", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "range", " ", "of", " ", "Rct0", " ", "values", " ", 
     "around", " ", "fit"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kDValues", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"kDFit", "/", "4"}], ",", 
       RowBox[{"kDFit", "/", "2"}], ",", "kDFit", ",", 
       RowBox[{"2", "*", "kDFit"}], ",", 
       RowBox[{"4", "*", "kDFit"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "legend", " ", "labels"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"legendLabels", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\"\<kD = \>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"1000", "*", "#"}], ",", 
            RowBox[{"{", 
             RowBox[{"6", ",", "1"}], "}"}]}], "]"}], "]"}], "<>", 
         "\"\< mM\>\""}], ")"}], "&"}], "/@", "kDValues"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "rainbow", " ", "colors"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"colors", "=", 
     RowBox[{
      RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "/@", 
      RowBox[{"Rescale", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "kDValues", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"Length", "[", "kDValues", "]"}]}], "}"}]}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Frequencies", " ", "to", " ", "evaluate", " ", "theory", " ", "curves"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"frequencies", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{"highestConcData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "theory", " ", "curves", " ", "as", " ", "lists", " ", 
     "of", " ", "points"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theoryCurves", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"f", ",", 
           RowBox[{"ModelFunction", "[", 
            RowBox[{"f", ",", "maxConc", ",", 
             RowBox[{"Join", "[", 
              RowBox[{"constants", ",", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<Rct0\>\"", "->", "rct0Fit"}], ",", 
                 RowBox[{"\"\<Rct1\>\"", "->", "rct1Fit"}], ",", 
                 RowBox[{"\"\<kD\>\"", "->", 
                  RowBox[{"kDValues", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                 RowBox[{"\"\<Capt\>\"", "->", "captFit"}]}], "|>"}]}], 
              "]"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"f", ",", "frequencies"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "rct1Values", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Make", " ", "the", " ", "theory", " ", "plot"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theoryPlot", "=", 
     RowBox[{"ListLogLinearPlot", "[", 
      RowBox[{"theoryCurves", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Directive", "[", 
            RowBox[{"#", ",", "Thick"}], "]"}], "&"}], "/@", "colors"}], 
         ")"}]}], ",", 
       RowBox[{"Joined", "->", "True"}], ",", 
       RowBox[{"PlotMarkers", "->", "None"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Frequency (Hz)\>\"", ",", "\"\<\[CapitalDelta]I (A)\>\""}], 
         "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"SwatchLegend", "[", 
           RowBox[{"colors", ",", "legendLabels", ",", 
            RowBox[{"LegendLabel", "->", "\"\<kD Values\>\""}]}], "]"}], ",", 
          "Right"}], "]"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "the", " ", "experimental", " ", "data"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expPlot", "=", 
     RowBox[{"ListLogLinearPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"highestConcData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", "Black", "}"}]}], ",", 
       RowBox[{"PlotMarkers", "->", 
        RowBox[{"{", "Automatic", "}"}]}], ",", 
       RowBox[{"Joined", "->", "False"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Combine", " ", "plots"}], "*)"}], "\n", 
   RowBox[{"Show", "[", 
    RowBox[{"theoryPlot", ",", "expPlot", ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}]], "Input",
