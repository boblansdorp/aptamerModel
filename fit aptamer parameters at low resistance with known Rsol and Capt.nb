Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Ranges", " ", "from", " ", "your", " ", "transformed", " ", "data"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"xMin", "=", 
     RowBox[{"Min", "[", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"dataTriplesLog", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"dataTriplesExpLog", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"xMax", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"dataTriplesLog", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"dataTriplesExpLog", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"yMin", "=", 
     RowBox[{"Min", "[", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"dataTriplesLog", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"dataTriplesExpLog", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"yMax", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"dataTriplesLog", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"dataTriplesExpLog", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"commonXY", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xMin", ",", "xMax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"yMin", ",", "yMax"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zMin", "=", 
     RowBox[{"Min", "[", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"dataTriplesLog", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "3"}], "]"}], "]"}], ",", 
        RowBox[{"dataTriplesExpLog", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"zMax", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"dataTriplesLog", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "3"}], "]"}], "]"}], ",", 
        RowBox[{"dataTriplesExpLog", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Actual", " ", "frequencies", " ", "present", " ", "in", " ", "the", " ", 
     "data"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"freqValues", "=", 
     RowBox[{"Union", "[", 
      RowBox[{"filteredData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Only", " ", "show", " ", "these", " ", "three", " ", "if", " ", "they", 
     " ", "exist"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"freqTicksToShow", "=", 
     RowBox[{"{", 
      RowBox[{"10", ",", "100", ",", "1000"}], "}"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xTicks", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Log10", "[", "#", "]"}], ",", 
          RowBox[{
           RowBox[{"ToString", "[", "#", "]"}], "<>", "\"\< Hz\>\""}]}], 
         "}"}], "&"}], ")"}], "/@", 
      RowBox[{"Select", "[", 
       RowBox[{"freqTicksToShow", ",", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"freqValues", ",", "#"}], "]"}], "&"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "THEORY", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theoryAligned", "=", 
     RowBox[{"ListContourPlot", "[", 
      RowBox[{"dataTriplesLog", ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Frequency (Hz)\>\"", ",", "\"\<Concentration (M)\>\""}],
          "}"}]}], ",", 
       RowBox[{"ScalingFunctions", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Linear\>\"", ",", "\"\<Log\>\""}], "}"}]}], ",", 
       RowBox[{"ColorFunction", "->", "\"\<Rainbow\>\""}], ",", 
       RowBox[{"Contours", "->", "20"}], ",", 
       RowBox[{"InterpolationOrder", "->", "2"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"commonXY", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"commonXY", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"zMin", ",", "zMax"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"FrameTicks", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", "None"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"xTicks", ",", "None"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "400"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "EXPERIMENT", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expAligned", "=", 
     RowBox[{"ListContourPlot", "[", 
      RowBox[{"dataTriplesExpLog", ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Frequency (Hz)\>\"", ",", "\"\<Concentration (M)\>\""}],
          "}"}]}], ",", 
       RowBox[{"ScalingFunctions", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Linear\>\"", ",", "\"\<Log\>\""}], "}"}]}], ",", 
       RowBox[{"ColorFunction", "->", "\"\<Rainbow\>\""}], ",", 
       RowBox[{"Contours", "->", "20"}], ",", 
       RowBox[{"InterpolationOrder", "->", "2"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"commonXY", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"commonXY", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"zMin", ",", "zMax"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"FrameTicks", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", "None"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"xTicks", ",", "None"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "400"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Get", " ", "the", " ", "image", " ", "height", " ", "of", " ", "the", 
     " ", "contour", " ", "plots"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Build", " ", "a", " ", "vertically", " ", "oriented", " ", "colorbar", 
     " ", "graphic", " ", "of", " ", "matching", " ", "height"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"colorBarGraphic", "=", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"Inset", "[", 
        RowBox[{"BarLegend", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<Rainbow\>\"", ",", 
            RowBox[{"{", 
             RowBox[{"zMin", ",", "zMax"}], "}"}]}], "}"}], ",", 
          RowBox[{"LegendLabel", "->", "\"\<\[CapitalDelta]I (A)\>\""}], ",", 
          RowBox[{"LabelStyle", "->", "14"}]}], " ", "]"}], "]"}], ",", " ", 
       RowBox[{"ImageSize", "->", "100"}]}], "]"}]}], ";"}], "\n", "\n", "\n", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"theoryAligned", ",", "expAligned"}], "}"}], ",", 
     RowBox[{"Spacings", "->", "2"}]}], "]"}], "\n", "\n", "\n"}]}]], "Input",
