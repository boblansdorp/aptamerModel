  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"freqGrid", "=", 
     RowBox[{"Union", "[", 
      RowBox[{"filteredData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Use", " ", "your", " ", "existing", " ", "concentration", " ",
      "grid"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"concGridCeil", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"concRange", ",", 
       RowBox[{
        RowBox[{"#", "<=", "0.01"}], "&"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Extract", " ", "fitted", " ", "parameters", " ", "and", " ", 
     "build", " ", "a", " ", "parameter", " ", "association"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rct0Fit", "=", 
     RowBox[{"result", "[", "\"\<Rct0\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rct1Fit", "=", 
     RowBox[{"result", "[", "\"\<Rct1\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kDFit", "=", 
     RowBox[{"result", "[", "\"\<kD\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"captFit", "=", 
     RowBox[{"result", "[", "\"\<Capt\>\"", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"paramsFit", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"constants2", ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rct0\>\"", "->", "rct0Fit"}], ",", 
         RowBox[{"\"\<Rct1\>\"", "->", "rct1Fit"}], ",", 
         RowBox[{"\"\<kD\>\"", "->", "kDFit"}], ",", 
         RowBox[{"\"\<Capt\>\"", "->", "captFit"}]}], "|>"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Build", " ", "raw", " ", 
     RowBox[{"(", 
      RowBox[{"f", ",", "c", ",", "current"}], ")"}], " ", "triples", " ", 
     "for", " ", "ListContourPlot"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dataTriples", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"freqGrid", "[", 
