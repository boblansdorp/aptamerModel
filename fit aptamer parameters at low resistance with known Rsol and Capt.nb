     RowBox[{"filteredData", "/.", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"f_", ",", "c_", ",", "cur_"}], "}"}], ":>", 
       RowBox[{"{", 
        RowBox[{"f", ",", "c", ",", 
         RowBox[{"cur", "/", "f"}]}], "}"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"2.", " ", "Log"}], "-", 
     RowBox[{
     "transform", " ", "frequency", " ", "for", " ", "plotting", " ", "on", 
      " ", "log"}], "-", 
     RowBox[{"x", " ", "axis"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dataTriplesExpLog", "=", 
     RowBox[{"dataTriplesExp", "/.", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"f_", ",", "c_", ",", "z_"}], "}"}], ":>", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Log10", "[", "f", "]"}], ",", "c", ",", "z"}], "}"}]}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Make", " ", "the", " ", "contour", " ", "plot"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expContourPlot", "=", 
     RowBox[{"ListContourPlot", "[", 
      RowBox[{"dataTriplesExpLog", ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Frequency (Hz)\>\"", ",", "\"\<Concentration (M)\>\""}],
          "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
       RowBox[{"ColorFunction", "->", "\"\<AvocadoColors\>\""}], ",", 
       RowBox[{"Contours", "->", "20"}], ",", 
       RowBox[{"InterpolationOrder", "->", "2"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"ScalingFunctions", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Linear\>\"", ",", "\"\<Log\>\""}], "}"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{"log", "-", 
         RowBox[{"y", " ", "concentration", " ", "axis"}]}], "*)"}], 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "expContourPlot", "\n"}]}]], "Input",
