Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Find", " ", "lowest", " ", "concentration"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"uniqueConcs", "=", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"filteredData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxConc", "=", 
     RowBox[{"Max", "[", "uniqueConcs", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Extract", " ", "data", " ", "at", " ", "lowest", " ", "concentration"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"highestConcData", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"filteredData", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "==", "maxConc"}], "&"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "fitted", " ", "parameters"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rct0Fit", "=", 
     RowBox[{"result", "[", "\"\<Rct0\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rct1Fit", "=", 
     RowBox[{"result", "[", "\"\<Rct1\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kDFit", "=", 
     RowBox[{"result", "[", "\"\<kD\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"captFit", "=", 
     RowBox[{"result", "[", "\"\<Capt\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "range", " ", "of", " ", "Rct0", " ", "values", " ", 
     "around", " ", "fit"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rct1Values", "=", 
     RowBox[{"{", 
      RowBox[{
      "2000", ",", "3000", ",", "rct1Fit", ",", "8000", ",", "10000"}], 
      "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "legend", " ", "labels"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"legendLabels", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "0"}], "}"}]}], "]"}], "]"}], "&"}], "/@", 
      "rct1Values"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "rainbow", " ", "colors"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"colors", "=", 
     RowBox[{
      RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "/@", 
      RowBox[{"Rescale", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "rct1Values", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"Length", "[", "rct0Values", "]"}]}], "}"}]}], "]"}]}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Frequencies", " ", "to", " ", "evaluate", " ", "theory", " ", "curves"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"frequencies", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{"highestConcData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "theory", " ", "curves", " ", "as", " ", "lists", " ", 
     "of", " ", "points"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theoryCurves", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"f", ",", 
           RowBox[{"ModelFunction", "[", 
            RowBox[{"f", ",", "maxConc", ",", 
             RowBox[{"Join", "[", 
              RowBox[{"constants", ",", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<Rct0\>\"", "->", "rct0Fit"}], ",", 
                 RowBox[{"\"\<Rct1\>\"", "->", 
                  RowBox[{"rct1Values", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                 RowBox[{"\"\<kD\>\"", "->", "kDFit"}], ",", 
                 RowBox[{"\"\<Capt\>\"", "->", "captFit"}]}], "|>"}]}], 
              "]"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"f", ",", "frequencies"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "rct1Values", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Make", " ", "the", " ", "theory", " ", "plot"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"theoryPlot", "=", 
     RowBox[{"ListLogLinearPlot", "[", 
      RowBox[{"theoryCurves", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Directive", "[", 
            RowBox[{"#", ",", "Thick"}], "]"}], "&"}], "/@", "colors"}], 
         ")"}]}], ",", 
       RowBox[{"Joined", "->", "True"}], ",", 
       RowBox[{"PlotMarkers", "->", "None"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Frequency (Hz)\>\"", ",", "\"\<\[CapitalDelta]I (A)\>\""}], 
         "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"SwatchLegend", "[", 
           RowBox[{"colors", ",", "legendLabels", ",", 
            RowBox[{"LegendLabel", "->", "\"\<Rct1 Values\>\""}]}], "]"}], 
          ",", "Right"}], "]"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "the", " ", "experimental", " ", "data"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expPlot", "=", 
     RowBox[{"ListLogLinearPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"highestConcData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", "Black", "}"}]}], ",", 
       RowBox[{"PlotMarkers", "->", 
        RowBox[{"{", "Automatic", "}"}]}], ",", 
       RowBox[{"Joined", "->", "False"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Combine", " ", "plots"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"theoryPlot", ",", "expPlot", ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\n"}]}]], "Input",
