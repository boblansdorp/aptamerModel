Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "rate", " ", "constants", " ", "based", " ", "on", " ", 
    "VAptamerGold"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"koxExpr", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "fBound"}], ")"}], " ", "k0u", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"alpha", " ", "F", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"VAptamerGold", "[", "t", "]"}], "-", "E0"}], ")"}], "/", 
