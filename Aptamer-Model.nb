            RowBox[{"VAptamerGold", "[", "t", "]"}], "-", "E0"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"R", " ", "T"}], ")"}]}]}], "]"}]}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"kredExpr", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "fBound"}], ")"}], " ", "k0u", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"1", "-", "alpha"}], ")"}]}], " ", "F", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"VAptamerGold", "[", "t", "]"}], "-", "E0"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"R", " ", "T"}], ")"}]}]}], "]"}]}], "+", 
      RowBox[{"fBound", " ", "k0b", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"1", "-", "alpha"}], ")"}]}], " ", "F", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"VAptamerGold", "[", "t", "]"}], "-", "E0"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"R", " ", "T"}], ")"}]}]}], "]"}]}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Oxidation", " ", "fraction", " ", "differential", " ", "equation"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"aptamerODE", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"fOx", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"koxExpr", " ", 
        RowBox[{"(", 
