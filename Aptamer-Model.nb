Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Generate", " ", "a", " ", "list", " ", "of", " ", "SWV", " ", "data", " ",
     "points"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "iForwardSWV", " ", "and", " ", "iReverseSWV", " ", "and", " ", 
    "IdiffSWV"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"First", ":", " ", 
    RowBox[{
    "get", " ", "the", " ", "time", " ", "before", " ", "each", " ", "a", " ",
      "potential", " ", "switch", " ", "in", " ", 
     RowBox[{"VAptamerGold", "[", "t", "]"}], " ", "for", " ", "forward", " ",
      "steps", " ", "and", " ", "backward", " ", "steps"}]}], " ", "*)"}], 
  "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Next", ":", " ", 
    RowBox[{
    "using", " ", "the", " ", "iForwardStepTimes", " ", "list", " ", 
     "calculate", " ", "the", " ", "current", " ", "at", " ", "that", " ", 
     "time", " ", 
     RowBox[{"iForwardSWV", "[", "t", "]"}]}]}], " ", "*)"}], " ", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Next", ":", " ", 
    RowBox[{
    "using", " ", "the", " ", "iReverseStepTimes", " ", "list", " ", 
     "calculate", " ", "the", " ", "current", " ", "at", " ", "that", " ", 
     "time", " ", 
     RowBox[{"iReverseSWV", "[", "t", "]"}]}]}], " ", "*)"}], " ", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Finally", " ", "calculate", " ", "idiffSWV", " ", "as", " ", "the", " ", 
    "difference", " ", "between", " ", "forward", " ", "and", " ", 
    "reverse"}], " ", "*)"}]}]], "Input",
 CellChangeTimes->{3.951230688492113*^9, 3.9512445488066235`*^9, 
  3.951246675396484*^9},
 CellLabel->
  "In[2269]:=",ExpressionUUID->"7efeca76-28ef-416c-af9b-23600fe4dc74"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "Forward", " ", "and", " ", "Reverse", " ", "Currents", 
    " ", "at", " ", "Each", " ", "Step"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Example", " ", "noisyCurrentSamples", " ", "structure"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"noisyCurrentSamples", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t1", ",", "i1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t2", ",", "i2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t3", ",", "i3"}], "}"}], ",", "...", ",", 
      RowBox[{"{", 
       RowBox[{"tn", ",", "in"}], "}"}]}], "}"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"For", " ", "each", " ", "switch", " ", "time"}], ",", 
    RowBox[{
    "find", " ", "the", " ", "nearest", " ", "earlier", " ", "time", " ", 
     "point"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "find", " ", "the", " ", "current", " ", 
    "value", " ", "just", " ", "before", " ", "each", " ", "switch", " ", 
    "time"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"findPrecedingCurrent", "[", 
      RowBox[{"switchTimes_List", ",", "data_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"times", "=", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", "result"}], "}"}],
        ",", 
       RowBox[{
        RowBox[{"result", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Block", "[", 
            RowBox[{
             RowBox[{"{", "index", "}"}], ",", 
             RowBox[{
              RowBox[{"index", "=", 
               RowBox[{"SelectFirst", "[", 
                RowBox[{
                 RowBox[{"Reverse", "[", 
                  RowBox[{"Range", "[", 
                   RowBox[{"Length", "[", "times", "]"}], "]"}], "]"}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"times", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], "<", "t"}], "&"}], ",", 
                 RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"MissingQ", "[", "index", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"t", ",", 
                  RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], 
                 "}"}], ",", 
                RowBox[{"data", "[", 
                 RowBox[{"[", "index", "]"}], "]"}]}], "]"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "switchTimes"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "result"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"iSWVFWDExp", "=", 
     RowBox[{"findPrecedingCurrent", "[", 
      RowBox[{"downSwitchTimes", ",", "noisyCurrentSamples"}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"iSWVREVExp", "=", 
     RowBox[{"findPrecedingCurrent", "[", 
      RowBox[{"upSwitchTimes", ",", "noisyCurrentSamples"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "difference"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"iSWVDiff", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"VApplied", "[", 
           RowBox[{"upSwitchTimes", "[", 
            RowBox[{"[", "n", "]"}], "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"iSWVFWDExp", "[", 
           RowBox[{"[", 
            RowBox[{"n", ",", "2"}], "]"}], "]"}], "-", 
          RowBox[{"iSWVREVExp", "[", 
           RowBox[{"[", 
            RowBox[{"n", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{"Length", "[", "iSWVFWDExp", "]"}], ",", 
           RowBox[{"Length", "[", "iSWVREVExp", "]"}]}], "]"}]}], "}"}]}], 
      "]"}]}], ";", 
    RowBox[{"iSWVFWDvsV", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"VApplied", "[", 
           RowBox[{"upSwitchTimes", "[", 
            RowBox[{"[", "n", "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"iSWVFWDExp", "[", 
