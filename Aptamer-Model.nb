   RowBox[{
    RowBox[{"aptamerODE", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"fOx", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{
        RowBox[{"kox", "[", "t", "]"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"fOx", "[", "t", "]"}]}], ")"}]}], "-", 
       RowBox[{
        RowBox[{"kred", "[", "t", "]"}], " ", 
        RowBox[{"fOx", "[", "t", "]"}]}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"initialAptamer", "=", 
     RowBox[{
      RowBox[{"fOx", "[", "0", "]"}], "==", "0"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   StyleBox[
    RowBox[{"(*", " ", 
     RowBox[{"Circuit", " ", "Equations"}], " ", "*)"}], "Section"], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Current", " ", "through", " ", "capacitor"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"iCap", "[", "t_", "]"}], ":=", 
     RowBox[{"Cint", " ", 
      RowBox[{
       RowBox[{"VAptamerGold", "'"}], "[", "t", "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Current", " ", "through", " ", "aptamer"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"iAptamer", "[", "t_", "]"}], ":=", 
     RowBox[{"nElec", "*", "F", "*", "A", "*", "Lambda", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"kox", "[", "t", "]"}], "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"fOx", "[", "t", "]"}]}], ")"}]}], "-", 
        RowBox[{
         RowBox[{"kred", "[", "t", "]"}], "*", 
         RowBox[{"fOx", "[", "t", "]"}]}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Total", " ", "current", " ", "through", " ", "resistor"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"iTotal", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"iCap", "[", "t", "]"}], "+", 
      RowBox[{"iAptamer", "[", "t", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Voltage", " ", "drop", " ", "across", " ", "resistor"}], "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"circuitODE", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"VApplied", "[", "t", "]"}], "-", 
       RowBox[{"VAptamerGold", "[", "t", "]"}]}], "==", 
      RowBox[{"RSol", "*", 
       RowBox[{"iTotal", "[", "t", "]"}]}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VCap0", " ", "=", "0"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"assume", " ", "initial", " ", "charge", " ", "zero"}], " ", 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Initial", " ", "voltage", " ", "condition"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"initialRC", "=", 
     RowBox[{
      RowBox[{"VAptamerGold", "[", "0", "]"}], "==", "VCap0"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Solve", " ", "for", " ", "VAptamerGold", " ", "and", " ", "fOx", " ", 
     "simultaneously"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solution", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "aptamerODE", ",", "circuitODE", ",", "initialAptamer", ",", 
         "initialRC"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"fOx", ",", "VAptamerGold"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "Tmax"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Redefine", " ", "functions", " ", "using", " ", "solution"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fOxSol", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"fOx", "[", "t", "]"}], "/.", " ", 
      RowBox[{"solution", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"VAptamerSol", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{"VAptamerGold", "[", "t", "]"}], "/.", " ", 
     RowBox[{"solution", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"i", "[", "t_", "]"}], " ", ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"VApplied", "[", "t", "]"}], "-", 
         RowBox[{"VAptamerGold", "[", "t", "]"}]}], "/.", " ", 
        RowBox[{"solution", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", "RSol"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"fOxSol", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "Tmax"}], "}"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "total", " ", "current"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"VAptamerSol", "[", "t", "]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "Tmax"}], "}"}], ",", " ", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "Automatic"}], "}"}]}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"LogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", "[", "t", "]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"Tmax", "/", "20"}]}], "}"}], ",", " ", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", 
           RowBox[{"-", "8"}]}], ",", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "4"}]}]}], "}"}]}], "}"}]}]}], "]"}]}]}]], "Input",
