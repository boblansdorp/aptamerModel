Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "find", " ", "the", " ", "current", " ", 
    "value", " ", "just", " ", "before", " ", "each", " ", "switch", " ", 
    "time"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"findPrecedingCurrent", "[", 
      RowBox[{"switchTimes_List", ",", "data_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"times", "=", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", "result"}], "}"}],
        ",", 
       RowBox[{
        RowBox[{"result", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", "index", "}"}], ",", 
             RowBox[{
              RowBox[{"index", "=", 
               RowBox[{"SelectFirst", "[", 
                RowBox[{
                 RowBox[{"Reverse", "[", 
                  RowBox[{"Range", "[", 
                   RowBox[{"Length", "[", "times", "]"}], "]"}], "]"}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"times", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], "<", "t"}], "&"}], ",", 
                 RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"MissingQ", "[", "index", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"t", ",", 
                  RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], 
                 "}"}], ",", 
                RowBox[{"data", "[", 
                 RowBox[{"[", "index", "]"}], "]"}]}], "]"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "switchTimes"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "result"}]}], "]"}]}], ";"}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"findPrecedingCurrent", "[", 
      RowBox[{"switchTimes_List", ",", "data_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"times", "=", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", "result"}], "}"}],
        ",", 
       RowBox[{
        RowBox[{"result", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", "index", "}"}], ",", 
             RowBox[{
              RowBox[{"index", "=", 
               RowBox[{"SelectFirst", "[", 
                RowBox[{
                 RowBox[{"Reverse", "[", 
                  RowBox[{"Range", "[", 
                   RowBox[{"3", ",", 
                    RowBox[{"Length", "[", "times", "]"}]}], "]"}], "]"}], 
                 ",", 
                 RowBox[{"(*", 
                  RowBox[{
                  "start", " ", "from", " ", "3", " ", "to", " ", "allow", 
                   " ", "two", " ", "steps", " ", "back"}], "*)"}], 
                 RowBox[{
                  RowBox[{
                   RowBox[{"times", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], "<", "t"}], "&"}], ",", 
                 RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"MissingQ", "[", "index", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"t", ",", 
                  RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], 
                 "}"}], ",", 
                RowBox[{"data", "[", 
                 RowBox[{"[", 
                  RowBox[{"index", "-", "1"}], "]"}], "]"}]}], "]"}]}]}], 
            "]"}], ",", 
           RowBox[{"(*", 
            RowBox[{"go", " ", "two", " ", "steps", " ", "back"}], "*)"}], 
           RowBox[{"{", 
            RowBox[{"t", ",", "switchTimes"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "result"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Apply", " ", "to", " ", "forward", " ", "and", " ", "reverse", " ", 
     "switches"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"iSWVFWDExpSlow", "=", 
