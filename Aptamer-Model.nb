Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"medianUpSwitchTimeSlow", "=", 
     RowBox[{"Median", "[", "upSwitchTimesSlow", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"medianUpSwitchTimeFast", "=", 
     RowBox[{"Median", "[", "upSwitchTimesFast", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\n", 
   RowBox[{
    RowBox[{"timeRangeSlow", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"medianUpSwitchTimeSlow", ",", 
       RowBox[{"medianUpSwitchTimeSlow", "+", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "SquareWaveSlowFreq"}], ")"}]}]}], ",", 
       RowBox[{"dt", "[", "SquareWaveSlowFreq", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"timeRangeFast", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"medianUpSwitchTimeFast", ",", 
       RowBox[{"medianUpSwitchTimeFast", "+", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "SquareWaveFastFreq"}], ")"}]}]}], ",", 
       RowBox[{"dt", "[", "SquareWaveFastFreq", "]"}]}], "]"}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"voltageTimePairsSlow", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"noisyCurrentSWVSlowData", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Tmax", "[", "SquareWaveSlowFreq", "]"}], "/", "2"}], "<=", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<=", 
          RowBox[{
           RowBox[{
            RowBox[{"Tmax", "[", "SquareWaveSlowFreq", "]"}], "/", "2"}], "+", 
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{"2", "*", "SquareWaveSlowFreq"}], ")"}]}]}]}], ")"}], 
        "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"voltageTimePairsFast", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"noisyCurrentSWVFastData", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Tmax", "[", "SquareWaveFastFreq", "]"}], "/", "2"}], "<=", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<=", 
          RowBox[{
           RowBox[{
            RowBox[{"Tmax", "[", "SquareWaveFastFreq", "]"}], "/", "2"}], "+", 
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{"2", "*", "SquareWaveFastFreq"}], ")"}]}]}]}], ")"}], 
        "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Convert", " ", "time", " ", "to", " ", "ms"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"voltageTimePairsSlow", "=", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", 
             RowBox[{
              RowBox[{"Tmax", "[", "SquareWaveSlowFreq", "]"}], "/", "2"}]}], 
            ")"}], "*", "1000"}], ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], "/@", 
       "voltageTimePairsSlow"}], ")"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"voltageTimePairsFast", "=", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", 
             RowBox[{
              RowBox[{"Tmax", "[", "SquareWaveFastFreq", "]"}], "/", "2"}]}], 
            ")"}], "*", "1000"}], ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], "/@", 
       "voltageTimePairsFast"}], ")"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Now", " ", "plot"}], "*)"}], "\n", 
   RowBox[{"ListLogLogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"voltageTimePairsSlow", ",", "voltageTimePairsFast"}], "}"}], 
     ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<time (ms)\>\"", ",", "\"\<i (A)\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Current vs Voltage (Log-Log Scale)\>\""}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.01", ",", " ", "100"}], "}"}], ",", "Automatic"}], 
       "}"}]}], ",", 
     RowBox[{"Joined", "->", "True"}]}], "]"}], "\n"}]}]], "Input",
