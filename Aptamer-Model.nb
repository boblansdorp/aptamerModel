    "need", " ", "to", " ", "replace", " ", "this", " ", "with", " ", 
     "frequency"}], "-", 
    RowBox[{"domain", " ", "noise", " ", "function", " ", 
     RowBox[{"later", "!"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "Noisy", " ", "Signal", " ", "at", " ", "Sampled", " ", 
