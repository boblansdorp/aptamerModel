    RowBox[{"tsSlow", "=", 
     RowBox[{"timeSamples", "[", "SquareWaveSlowFreq", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tsFast", "=", 
     RowBox[{"timeSamples", "[", "SquareWaveFastFreq", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "noise", " ", "vectors", " ", "once"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"noiseValuesSlow", "=", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", "noiseStd"}], "]"}], ",", 
       RowBox[{"Length", "[", "tsSlow", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"noiseValuesFast", "=", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", "noiseStd"}], "]"}], ",", 
       RowBox[{"Length", "[", "tsFast", "]"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "model", " ", "current", " ", "once", " ", "over", " ", 
     "timeSamples"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"modelCurrentSWVSlow", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"iSWVSlow", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tsSlow"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"modelCurrentSWVFast", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"iSWVFast", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tsFast"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Add", " ", 
     RowBox[{"noise", ":", "vectorized"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"noisyCurrentSWVSlowData", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tsSlow", ",", 
        RowBox[{"modelCurrentSWVSlow", "+", "noiseValuesSlow"}]}], "}"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"noisyCurrentSWVFastData", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tsFast", ",", 
        RowBox[{"modelCurrentSWVFast", "+", "noiseValuesFast"}]}], "}"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "to", " ", "check"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"noisyCurrentSWVSlowData", ",", 
     RowBox[{"PlotLabel", "->", "\"\<Noisy Current SWV Slow\>\""}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<t (s)\>\"", ",", "\"\<Current (A)\>\""}], "}"}]}], ",", 
     RowBox[{"Joined", "->", "True"}]}], "]"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"noisyCurrentSWVFastData", ",", 
     RowBox[{"PlotLabel", "->", "\"\<Noisy Current SWV Fast\>\""}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<t (s)\>\"", ",", "\"\<Current (A)\>\""}], "}"}]}], ",", 
     RowBox[{"Joined", "->", "True"}]}], "]"}], "\n", "\[IndentingNewLine]", 
   "\n"}]}]], "Input",
