  RowBox[{"(*", 
   RowBox[{"Generate", " ", "noise", " ", "values"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"noiseStd", "=", 
     RowBox[{"1", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Standard", " ", "deviation", " ", "of", " ", "noise", " ", "in", " ", 
     "Amperes"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"noisyCurrent", "[", "t_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"i", "[", "t", "]"}], " ", "+", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", "noiseStd"}], "]"}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Evaluate", " ", "model", " ", "current", " ", "and", " ", "add", " ", 
     "noise"}], "*)"}], "\[IndentingNewLine]", 
